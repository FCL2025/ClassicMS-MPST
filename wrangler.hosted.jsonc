// Hosted 模式「預覽」Worker 設定（workers.dev，無自訂網域）。
// 正式站 classic.maplepstutorial.com 用的是根目錄 wrangler.jsonc（同名內容、
// Worker 名稱 msclassic-viewer、含 routes），由 Cloudflare GitHub 串接部署。
// 本檔用途：手動 `npm run deploy:hosted` 部署 msclassic-hosted 當預覽/測試環境。
// 資料上傳：npm run upload:hosted-data -- <version>
{
  "name": "msclassic-hosted",
  "main": "workers/hosted.js",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./dist-hosted",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "msclassic-data"
    }
  ],
  "workers_dev": true
}
